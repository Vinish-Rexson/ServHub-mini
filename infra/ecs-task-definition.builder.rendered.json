{
  "family": "servhub-mini-builder",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::421454275395:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::421454275395:role/servhub-mini-builder-task-role",
  "containerDefinitions": [
    {
      "name": "servhub-mini-builder",
      "image": "421454275395.dkr.ecr.ap-south-1.amazonaws.com/servhub-mini-builder:latest",
      "essential": true,
      "environment": [
        {
          "value": "ap-south-1",
          "name": "AWS_REGION"
        },
        {
          "value": "https://sqs.ap-south-1.amazonaws.com/421454275395/servhub-mini-builds",
          "name": "SQS_QUEUE_URL"
        },
        {
          "value": "servhub-mini-deployments-421454275395",
          "name": "S3_BUCKET_NAME"
        },
        {
          "value": "yourplatform.dev",
          "name": "PLATFORM_DOMAIN"
        },
        {
          "value": "600",
          "name": "SQS_VISIBILITY_TIMEOUT_SECONDS"
        },
        {
          "value": "20",
          "name": "SQS_WAIT_TIME_SECONDS"
        }
      ],
      "secrets": [
        {
          "valueFrom": "arn:aws:ssm:ap-south-1:421454275395:parameter/servhub-mini/builder/SUPABASE_URL",
          "name": "SUPABASE_URL"
        },
        {
          "valueFrom": "arn:aws:ssm:ap-south-1:421454275395:parameter/servhub-mini/builder/SUPABASE_SERVICE_ROLE_KEY",
          "name": "SUPABASE_SERVICE_ROLE_KEY"
        }
      ],
      "logConfiguration": {
        "options": {
          "awslogs-group": "/ecs/servhub-mini-builder",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        },
        "logDriver": "awslogs"
      }
    }
  ]
}
