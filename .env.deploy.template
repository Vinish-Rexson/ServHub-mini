# ==============================================================================
# ServHub-Mini Deployment Configuration
# Copy this file to .env.deploy and fill in your values.
# .env.deploy is ignored by git and will NEVER be committed to GitHub.
# ==============================================================================

# ── SUPABASE (Get from Supabase Dashboard -> Project Settings) ────────────────
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database connection strings (Supabase -> Project Settings -> Database)
# Pooled (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_NEW_DB_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct (Session pooler or direct, port 5432)
DIRECT_DATABASE_URL=postgresql://postgres:[YOUR_NEW_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# ── GITHUB OAUTH APP (GitHub -> Settings -> Developer settings -> OAuth Apps) ─
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_WEBHOOK_SECRET=generate_any_random_32_character_string_here

# ── DOMAINS & PLATFORM ─────────────────────────────────────────────────────────
DOMAIN=4istudios.in
APP_DOMAIN=servhub.4istudios.in
API_DOMAIN=api-servhub.4istudios.in
